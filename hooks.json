{
  "context-session-tracker": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node --no-warnings ./hooks/record_session.mjs || echo {}",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node --no-warnings ./hooks/record_session.mjs || echo {}",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node --no-warnings ./hooks/record_session.mjs || echo {}",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node --no-warnings ./hooks/record_session.mjs --stop || echo {}",
        "timeout": 5
      }
    ]
  }
}
